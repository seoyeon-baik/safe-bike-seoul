# Copy to .env.local. Never put real secrets in this example file.
# Place search mode only. Stations, routes, accident hotspots and weather ALWAYS use real APIs.
API_DATA_MODE=demo

# Server only: no NEXT_PUBLIC_ prefix. Portal general key (Decoding).
SEOUL_API_KEY=
DATA_GO_KR_SERVICE_KEY=
# Kakao Map local search + /v2/routing/bicycle REST API (server-only)
KAKAO_REST_API_KEY=

# Browser-visible JavaScript SDK key. Restrict SDK domains in Kakao Developers.
# Never put a REST API key or an Admin key here.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Optional dedicated DATA.GO.KR key authorized for bicycle accident hotspots (Decoding).
# If blank, DATA_GO_KR_SERVICE_KEY is used; API usage approval is still required.
TAAS_API_KEY=
